# ==============================================================================
# SEHATSTOCK ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and populate the secrets.
# Never commit real API keys or database credentials to git.
# ==============================================================================

# Database Connection (Neon PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/sehatstock?sslmode=require"

# AI Intelligence Suite (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key-here"

# NextAuth / Session Secret
AUTH_SECRET="super-secret-random-32-character-string"
NEXTAUTH_URL="http://localhost:3000"

# Pharmacy Branch Details
NEXT_PUBLIC_BRANCH_NAME="Central Health Pharmacy (Branch #1)"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_STAFF_MAX_DISCOUNT_PERCENT="3"
